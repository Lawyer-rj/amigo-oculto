# Copie este arquivo para ".env" e preencha.

# Endereço público usado nos links do WhatsApp (sem barra no final).
# No teste local: http://localhost:3000   Na VPS: https://amigooculto.seudominio.com.br
BASE_URL=http://localhost:3000

# Senha do painel do organizador.
ADMIN_SENHA=troque-esta-senha

# Chave que cifra os pares do sorteio e assina a sessão do painel.
# Gere uma vez e NUNCA troque depois do sorteio (os pares ficariam ilegíveis).
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Porta no computador (opcional)
PORTA_LOCAL=3000

# Serviços opcionais. Sem estas credenciais, use "Abrir mensagem" no painel.
# E-mail (Resend): verifique o domínio remetente no serviço.
RESEND_API_KEY=
EMAIL_REMETENTE=

# SMS e WhatsApp (Twilio): número habilitado para cada canal, com código do país.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# IDs HX... de modelos WhatsApp aprovados (um para convite e outro para resultado).
# Variáveis de ambos: {{1}} nome do participante, {{2}} nome da edição, {{3}} link pessoal completo.
TWILIO_WHATSAPP_CONVITE_SID=
TWILIO_WHATSAPP_RESULTADO_SID=

# WhatsApp: twilio (padrão) ou meta (API oficial diretamente).
WA_PROVEDOR=twilio

# Usados apenas com WA_PROVEDOR=meta. Não exigem credenciais Twilio.
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
# Versão suportada mostrada no painel da Meta, no formato vNN.0.
# Obrigatória: a versão antiga do projeto de referência não foi fixada aqui.
WA_GRAPH_VERSION=
WA_TEMPLATE_LANGUAGE=pt_BR
# Nomes dos modelos aprovados na Meta, com dois parâmetros de corpo:
# {{1}} nome do participante, {{2}} link pessoal completo.
WA_TEMPLATE_CONVITE=
WA_TEMPLATE_RESULTADO=

# Desativado por padrão: nenhum envio por API paga.
# Só altere se decidir contratar e configurar um serviço posteriormente.
ENVIO_POR_SERVICO=desativado
